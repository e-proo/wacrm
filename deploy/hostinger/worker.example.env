# Copy to repository root .env.worker; chmod 600; never commit.
# Use the exact same secrets as the WACRM app's .env.local.
CRON_SECRET=replace-with-existing-app-cron-secret
AUTOMATION_CRON_SECRET=replace-with-existing-app-automation-cron-secret
# This explicit ACK means approved queued TEST jobs may send messages.
WACRM_TEST_WORKERS_ACK=off
